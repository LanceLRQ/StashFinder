{
  "mainBinaryName": "StashFinder",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "installer/installed.clients": "installed.clients",
      "installer/installed.marker": "installed.marker"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
