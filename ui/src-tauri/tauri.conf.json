{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StashFinder",
  "version": "0.1.0",
  "identifier": "io.github.lancelrq.stashfinder",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StashFinder",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
